+///
+/// Android patch: inside a menu that closes only on a tap outside (the context menus below), a
+/// submenu unfolds in place when its header is tapped, and folds again on the next tap. egui's
+/// own submenus open while the pointer hovers, and a finger "hovers" everything it touches, so
+/// they opened and activated by accident.
 pub fn menu_button<'a, R>(ui: &mut Ui, atoms: impl egui::IntoAtoms<'a>, contents: impl FnOnce(&mut Ui) -> R) -> egui::InnerResponse<Option<R>> {
     if !egui::containers::menu::is_in_menu(ui) {
         return ui.menu_button(atoms, contents);
     }
+    if egui::containers::menu::MenuConfig::find(ui).close_behavior == egui::PopupCloseBehavior::CloseOnClickOutside {
+        // the header: a button whose chevron points down while the submenu is unfolded
+        let id = ui.next_auto_id().with("unfolded");
+        let open: bool = ui.data(|d| d.get_temp(id)).unwrap_or(false);
+        let button = egui::Button::new(atoms.into_atoms()).right_text("    ");
+        let response = ui.add(button);
+        let center = pos2(response.rect.right() - ui.spacing().button_padding.x - 8.0, response.rect.center().y);
+        let icon = if open { Icon::ChevronDown } else { Icon::ChevronRight };
+        paint(ui.painter(), Rect::from_center_size(center, vec2(16.0, 16.0)), icon, ui.style().interact(&response).fg_stroke.color);
+        let open = if response.clicked() { !open } else { open };
+        ui.data_mut(|d| d.insert_temp(id, open));
+        // the entries of an unfolded submenu are indented under the header
+        let inner = open.then(|| ui.indent(id, contents).inner);
+        return egui::InnerResponse::new(inner, response);
+    }
     let button = egui::Button::new(atoms.into_atoms()).right_text("    ");
