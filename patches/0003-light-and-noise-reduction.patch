+//! Wavelet noise reduction (Android port).
+//!
+//! The picture is split into detail bands with the stationary ("à trous") wavelet transform: each
+//! level blurs the previous one with the 5-tap B3-spline kernel spread over `2^level` pixels, and
+//! the detail band of that level is the difference between the two. Noise lives in the fine bands
+//! as many small coefficients; real edges and texture are the few large ones. Shrinking the small
+//! coefficients and adding the bands back removes the noise without blurring the edges, which is
+//! what a plain blur or a guided filter cannot do at high strength.
+//!
+//! * The noise level is measured from the picture itself, per 32 × 32 block, as the median
+//!   absolute value of the finest band (the robust estimator of Donoho and Johnstone); the lowest
+//!   estimate of the 3 × 3 neighbouring blocks is used so that an edge does not pass for noise.
+//!   The level follows the brightness, which matters because noise is stronger in the shadows.
+//! * A coefficient is attenuated by a smooth gain that is 0 below a threshold of `T` and 1 above
+//!   `2T`, where `T` is the local noise level of that band times the strength.
+//! * Luminance is cleaned in the logarithm of the luminance, colour noise in the logarithm of the
+//!   chromaticity (`rgb / Y`), with more levels, because colour noise comes in blotches.
+//!
+//! The sliders map to it as: *Luminance* / *Color* = strength, *Detail* = how little the finest
+//! bands are thresholded, *Contrast* = how little the coarse luminance bands are thresholded,
+//! *Color Detail* = as Detail for colour, *Smoothness* = how much the coarse colour bands are
+//! thresholded.
+//!
+//! The functions never panic: a non-finite sample counts as zero and a picture smaller than the
+//! kernel is returned unchanged.
+
+use lightcraft_color::luminance_2020;
+use lightcraft_raster::{Plane, Rgb32f};
+
+use crate::for_rows;
+
+/// The B3-spline kernel of the à trous transform.
+const KERNEL: [f32; 5] = [1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0, 4.0 / 16.0, 1.0 / 16.0];
+
+/// Standard deviation of the detail band of level `j` per unit of the white noise in the input
+/// (2D B3-spline à trous), divided by that of level 0. Real noise is correlated (demosaicing,
+/// the camera's own smoothing), so its coarse bands hold more than white noise would: these are
+/// [`BAND_RATIO`] multiplied by a correlation allowance.
+const BAND_RATIO: [f32; 6] = [1.0, 0.225 * 1.5, 0.097 * 2.0, 0.046 * 2.4, 0.0225 * 2.8, 0.0112 * 3.0];
+
+/// Side of the blocks the noise level is measured in, in pixels.
+const BLOCK: usize = 32;
+
+/// The picture smaller than this on a side is not filtered.
+const MIN_SIDE: usize = 8;
+
+/// How strongly a band is thresholded: the strength of the whole filter, and per-band factors
+/// (1 = the full threshold of the strength).
+#[derive(Clone, Copy, Debug)]
+struct Bands {
+    /// 0..1, from the slider.
+    strength: f32,
+    /// Number of detail bands (levels) to clean.
+    levels: usize,
+    /// Per level multiplier of the threshold; levels past the end use the last.
+    factors: [f32; 6],
+}
+
+/// The noise level (standard deviation of the finest band) measured per block, read back with
+/// bilinear interpolation.
+struct NoiseGrid {
+    bw: usize,
+    bh: usize,
+    values: Vec<f32>,
+}
+
+impl NoiseGrid {
+    /// The noise level at pixel `(x, y)`.
+    fn at(&self, x: usize, y: usize) -> f32 {
+        let u = (x as f32 + 0.5) / BLOCK as f32 - 0.5;
+        let v = (y as f32 + 0.5) / BLOCK as f32 - 0.5;
+        let (u0, v0) = (u.floor().max(0.0), v.floor().max(0.0));
+        let (fu, fv) = ((u - u0).clamp(0.0, 1.0), (v - v0).clamp(0.0, 1.0));
+        let at = |i: f32, j: f32| -> f32 {
+            let (i, j) = ((i as usize).min(self.bw.saturating_sub(1)), (j as usize).min(self.bh.saturating_sub(1)));
+            self.values.get(j * self.bw + i).copied().unwrap_or(0.0)
+        };
+        let top = at(u0, v0) * (1.0 - fu) + at(u0 + 1.0, v0) * fu;
+        let bottom = at(u0, v0 + 1.0) * (1.0 - fu) + at(u0 + 1.0, v0 + 1.0) * fu;
+        top * (1.0 - fv) + bottom * fv
+    }
+}
+
+/// Reflects an index into `0..n` (mirror without repeating the edge sample).
+fn reflect(i: isize, n: usize) -> usize {
+    let n = n as isize;
+    if n <= 1 {
+        return 0;
+    }
+    let mut i = if i < 0 { -i } else { i };
+    if i >= n {
+        i = 2 * (n - 1) - i;
+    }
+    i.clamp(0, n - 1) as usize
+}
+
+/// One à trous smoothing: the B3-spline kernel with its taps `step` pixels apart, along rows then columns.
+fn atrous(p: &Plane, step: usize) -> Plane {
+    let (w, h) = (p.width, p.height);
+    let step = step as isize;
+    let mut tmp = Plane::new(w, h);
+    // along the rows
+    for_rows(&mut tmp.data, w, |y, row| {
+        let src = p.data.get(y * w..(y + 1) * w).unwrap_or(&[]);
+        for (x, out) in row.iter_mut().enumerate() {
+            let mut acc = 0.0;
+            for (k, weight) in KERNEL.iter().enumerate() {
+                let xi = reflect(x as isize + (k as isize - 2) * step, w);
+                acc += weight * src.get(xi).copied().unwrap_or(0.0);
+            }
+            *out = acc;
+        }
+    });
+    // along the columns
+    let mut out = Plane::new(w, h);
+    for_rows(&mut out.data, w, |y, row| {
+        let rows: [&[f32]; 5] = std::array::from_fn(|k| {
+            let yi = reflect(y as isize + (k as isize - 2) * step, h);
+            tmp.data.get(yi * w..(yi + 1) * w).unwrap_or(&[])
+        });
+        for (x, o) in row.iter_mut().enumerate() {
+            let mut acc = 0.0;
+            for (weight, r) in KERNEL.iter().zip(rows) {
+                acc += weight * r.get(x).copied().unwrap_or(0.0);
+            }
+            *o = acc;
+        }
+    });
+    out
+}
+
+/// Measures the noise level of the finest band `fine - coarse` per block.
+fn noise_grid(fine: &Plane, coarse: &Plane) -> NoiseGrid {
+    let (w, h) = (fine.width, fine.height);
+    let bw = w.div_ceil(BLOCK).max(1);
+    let bh = h.div_ceil(BLOCK).max(1);
+    let mut estimates = vec![0.0f32; bw * bh];
+    let mut scratch: Vec<f32> = Vec::with_capacity(BLOCK * BLOCK / 4);
+    for by in 0..bh {
+        for bx in 0..bw {
+            scratch.clear();
+            let (x0, y0) = (bx * BLOCK, by * BLOCK);
+            for y in (y0..(y0 + BLOCK).min(h)).step_by(2) {
+                for x in (x0..(x0 + BLOCK).min(w)).step_by(2) {
+                    let i = y * w + x;
+                    let d = (fine.data.get(i).copied().unwrap_or(0.0) - coarse.data.get(i).copied().unwrap_or(0.0)).abs();
+                    if d.is_finite() {
+                        scratch.push(d);
+                    }
+                }
+            }
+            if scratch.is_empty() {
+                continue;
+            }
+            let mid = scratch.len() / 2;
+            let (_, median, _) = scratch.select_nth_unstable_by(mid, |a, b| a.total_cmp(b));
+            // median of |N(0, s)| is 0.6745 s; the 1.1 makes up for the low bias of taking the lowest of nine estimates
+            if let Some(e) = estimates.get_mut(by * bw + bx) {
+                *e = *median / 0.6745 * 1.1;
+            }
+        }
+    }
+    // the lowest estimate of the neighbourhood: an edge raises the median of its block, noise does not
+    let mut values = estimates.clone();
+    for by in 0..bh {
+        for bx in 0..bw {
+            let mut low = f32::MAX;
+            for ny in by.saturating_sub(1)..(by + 2).min(bh) {
+                for nx in bx.saturating_sub(1)..(bx + 2).min(bw) {
+                    low = low.min(estimates.get(ny * bw + nx).copied().unwrap_or(f32::MAX));
+                }
+            }
+            if let Some(v) = values.get_mut(by * bw + bx) {
+                *v = if low == f32::MAX { 0.0 } else { low };
+            }
+        }
+    }
+    NoiseGrid { bw, bh, values }
+}
+
+/// Shrinks the detail band `fine - coarse` and adds it to `acc`.
+fn shrink_into(fine: &Plane, coarse: &Plane, acc: &mut Plane, grid: &NoiseGrid, level: usize, bands: &Bands) {
+    let w = fine.width;
+    let ratio = BAND_RATIO.get(level).or(BAND_RATIO.last()).copied().unwrap_or(0.0);
+    let factor = bands.factors.get(level).or(bands.factors.last()).copied().unwrap_or(1.0);
+    // at full strength a coefficient starts to pass from 2.3 sigma of its band and passes whole from 4.6 sigma
+    let scale = 2.3 * bands.strength.powf(0.85) * ratio * factor;
+    for_rows(&mut acc.data, w, |y, row| {
+        for (x, a) in row.iter_mut().enumerate() {
+            let i = y * w + x;
+            let d = fine.data.get(i).copied().unwrap_or(0.0) - coarse.data.get(i).copied().unwrap_or(0.0);
+            let t = grid.at(x, y) * scale;
+            let gain = if t <= 1e-9 { 1.0 } else { smooth_gain(d.abs() / t) };
+            *a += d * gain;
+        }
+    });
+}
+
+/// 0 for a coefficient below the threshold (`r` = |coefficient| / threshold ≤ 1), 1 from twice the
+/// threshold, a smooth step between.
+fn smooth_gain(r: f32) -> f32 {
+    let t = (r - 1.0).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// Cleans a plane: the sum of its shrunk detail bands and its coarsest residual.
+///
+/// With `unbias` the mean level that the removed noise took with it is put back. A picture's noise is
+/// additive in the linear data, so in the logarithm it pulls the average down by half its variance;
+/// taking the noise out would darken the picture (the shadows most) unless that half variance of what
+/// was removed is added again. The variance is the measured noise level of the finest band, scaled by
+/// the strength.
+fn clean_plane(p: &Plane, bands: &Bands, unbias: bool) -> Plane {
+    let (w, h) = (p.width, p.height);
+    if w < MIN_SIDE || h < MIN_SIDE || bands.strength <= 0.0 || bands.levels == 0 {
+        return p.clone();
+    }
+    // non-finite samples count as zero
+    let mut cur = Plane { width: w, height: h, data: p.data.iter().map(|v| if v.is_finite() { *v } else { 0.0 }).collect() };
+    let mut next = atrous(&cur, 1);
+    let grid = noise_grid(&cur, &next);
+    let mut acc = Plane::new(w, h);
+    for level in 0..bands.levels {
+        if level > 0 {
+            next = atrous(&cur, 1 << level);
+        }
+        shrink_into(&cur, &next, &mut acc, &grid, level, bands);
+        cur = next;
+        next = Plane::new(0, 0);
+    }
+    // the coarsest residual plus the shrunk bands
+    for (a, c) in acc.data.iter_mut().zip(&cur.data) {
+        *a += *c;
+    }
+    if unbias {
+        let removed = bands.strength.clamp(0.0, 1.0) * 0.9;
+        for_rows(&mut acc.data, w, |y, row| {
+            for (x, a) in row.iter_mut().enumerate() {
+                // level 0 holds 0.889 of the input noise; half the variance, in the log2 domain
+                let sigma = grid.at(x, y) / 0.889;
+                *a += (0.5 * std::f32::consts::LN_2 * sigma * sigma * removed).min(0.5);
+            }
+        });
+    }
+    acc
+}
+
+/// Luminance noise reduction of an image: its log luminance is cleaned and the colours follow.
+///
+/// `strength`, `detail` (keep fine detail) and `contrast` (keep coarse contrast) are 0..1.
+pub fn denoise_luminance(img: &mut Rgb32f, strength: f32, detail: f32, contrast: f32) {
+    let (w, h) = (img.width, img.height);
+    if w < MIN_SIDE || h < MIN_SIDE || strength <= 0.0 {
+        return;
+    }
+    let log = img.map(crate::local::log_lum);
+    // fine bands lose their threshold with Detail, coarse bands with Contrast
+    let fine = 1.2 - 0.7 * detail.clamp(0.0, 1.0);
+    let coarse = 1.0 - 0.7 * contrast.clamp(0.0, 1.0);
+    let bands = Bands { strength: strength.clamp(0.0, 1.0), levels: 4, factors: [fine, fine, coarse, coarse * 0.8, coarse * 0.6, coarse * 0.5] };
+    let cleaned = clean_plane(&log, &bands, true);
+    for_rows(&mut img.data, w, |y, row| {
+        for (x, p) in row.iter_mut().enumerate() {
+            let i = y * w + x;
+            let delta = cleaned.data.get(i).copied().unwrap_or(0.0) - log.data.get(i).copied().unwrap_or(0.0);
+            if delta.is_finite() {
+                let gain = delta.exp2();
+                *p = p.map(|v| v * gain);
+            }
+        }
+    });
+}
+
+/// Colour noise reduction of an image: the logarithm of the chromaticity (`rgb / Y`) is cleaned with
+/// more levels than luminance, and each pixel keeps its luminance.
+///
+/// `strength`, `detail` (keep small colour edges) and `smoothness` (thresholds the coarse bands more) are 0..1.
+pub fn denoise_chroma(img: &mut Rgb32f, strength: f32, detail: f32, smoothness: f32) {
+    let (w, h) = (img.width, img.height);
+    if w < MIN_SIDE || h < MIN_SIDE || strength <= 0.0 {
+        return;
+    }
+    // chromaticity in the log domain, with a small offset so that near-black channels do not run away
+    const EPS: f32 = 1e-4;
+    let luma: Vec<f32> = img.data.iter().map(|c| luminance_2020(*c).max(0.0)).collect();
+    let plane = |channel: usize| Plane {
+        width: w,
+        height: h,
+        data: img
+            .data
+            .iter()
+            .zip(&luma)
+            .map(|(c, y)| {
+                let v = c.get(channel).copied().unwrap_or(0.0);
+                if v.is_finite() { ((v.max(0.0) + EPS) / (y + EPS)).ln() } else { 0.0 }
+            })
+            .collect(),
+    };
+    let fine = 1.3 - 0.8 * detail.clamp(0.0, 1.0);
+    let coarse = 1.0 + 0.8 * smoothness.clamp(0.0, 1.0);
+    let bands = Bands { strength: strength.clamp(0.0, 1.0), levels: 5, factors: [fine, fine, coarse, coarse, coarse, coarse] };
+    let cleaned = [clean_plane(&plane(0), &bands, false), clean_plane(&plane(1), &bands, false), clean_plane(&plane(2), &bands, false)];
+    for_rows(&mut img.data, w, |y, row| {
+        for (x, p) in row.iter_mut().enumerate() {
+            let i = y * w + x;
+            let target = luma.get(i).copied().unwrap_or(0.0);
+            let mut q = [0.0f32; 3];
+            for (k, slot) in q.iter_mut().enumerate() {
+                let ratio = cleaned.get(k).and_then(|c| c.data.get(i)).copied().unwrap_or(0.0).exp();
+                *slot = (ratio * (target + EPS) - EPS).max(0.0);
+            }
+            // rescale so that the pixel keeps its luminance
+            let now = luminance_2020(q);
+            if now > 1e-9 && target.is_finite() {
+                let k = target / now;
+                *p = q.map(|v| v * k);
+            }
+        }
+    });
+}
