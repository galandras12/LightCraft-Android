+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A flat grey picture with a vertical edge and noise of a known level.
+    fn noisy(w: usize, h: usize, level: f32) -> Rgb32f {
+        let mut img = Rgb32f::new(w, h);
+        let mut seed = 12345u32;
+        let mut noise = move || {
+            // a sum of uniform numbers: close enough to Gaussian
+            let mut s = 0.0;
+            for _ in 0..4 {
+                seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                s += (seed >> 8) as f32 / 16_777_216.0 - 0.5;
+            }
+            s * level * 1.7
+        };
+        for y in 0..h {
+            for x in 0..w {
+                let base = if x < w / 2 { 0.15 } else { 0.45 };
+                let v = (base * (1.0 + noise())).max(1e-4);
+                img.data[y * w + x] = [v, v, v];
+            }
+        }
+        img
+    }
+
+    fn flat_spread(img: &Rgb32f, x0: usize, x1: usize) -> f32 {
+        let vals: Vec<f32> = (0..img.height).flat_map(|y| (x0..x1).map(move |x| (y, x))).map(|(y, x)| img.data[y * img.width + x][1].ln()).collect();
+        let mean = vals.iter().sum::<f32>() / vals.len() as f32;
+        (vals.iter().map(|v| (v - mean).powi(2)).sum::<f32>() / vals.len() as f32).sqrt()
+    }
+
+    #[test]
+    fn flat_areas_lose_noise_and_the_edge_stays() {
+        let mut img = noisy(160, 160, 0.20);
+        let before = flat_spread(&img, 10, 70);
+        denoise_luminance(&mut img, 0.8, 0.5, 0.0);
+        let after = flat_spread(&img, 10, 70);
+        assert!(after < before * 0.5, "noise {before} -> {after}");
+        // the edge between 0.15 and 0.45 is still there
+        let dark = img.data[80 * 160 + 40][1];
+        let light = img.data[80 * 160 + 120][1];
+        assert!(light > dark * 2.0, "edge: {dark} / {light}");
+    }
+
+    #[test]
+    fn zero_strength_and_tiny_pictures_are_left_alone() {
+        let mut img = noisy(64, 64, 0.2);
+        let copy = img.clone();
+        denoise_luminance(&mut img, 0.0, 0.5, 0.0);
+        denoise_chroma(&mut img, 0.0, 0.5, 0.0);
+        assert_eq!(img.data, copy.data);
+        let mut tiny = Rgb32f::filled(3, 3, [0.2, 0.3, 0.4]);
+        denoise_luminance(&mut tiny, 1.0, 0.5, 0.0);
+        denoise_chroma(&mut tiny, 1.0, 0.5, 0.0);
+        assert_eq!(tiny.data[0], [0.2, 0.3, 0.4]);
+    }
+
+    #[test]
+    fn non_finite_samples_do_not_panic_or_spread() {
+        let mut img = noisy(64, 64, 0.1);
+        img.data[100] = [f32::NAN, f32::INFINITY, -1.0];
+        denoise_luminance(&mut img, 1.0, 0.0, 0.0);
+        denoise_chroma(&mut img, 1.0, 0.0, 1.0);
+        let finite = img.data.iter().filter(|p| p.iter().all(|v| v.is_finite())).count();
+        assert!(finite >= img.data.len() - 4, "{finite} of {} finite", img.data.len());
+    }
+}
