+/// The colour range selector for touch screens (Android port), the counterpart of [`wb_picker_touch`]: a ring is
+/// dragged onto the colour to select (a tap on the photo moves it there). The check button samples the colour; the
+/// first sample replaces the range, every later one is added to it (up to 5, what ⇧-click does on a desktop). The
+/// "+ / 1" chip switches between adding and replacing. The cross closes the selector.
+fn color_range_touch(app: &mut LightcraftApp, ui: &mut egui::Ui, resp: &egui::Response, map: &CanvasMap) {
+    const RING: f32 = 46.0;
+    let canvas = app.canvas_rect.unwrap_or(map.rect);
+    let img = map.rect.intersect(canvas);
+    let key = egui::Id::new("color-range-spot");
+    let add_key = egui::Id::new("color-range-add");
+    let mut spot: Pos2 = ui.data(|d| d.get_temp::<Pos2>(key)).filter(|p| img.contains(*p)).unwrap_or_else(|| img.center());
+    if resp.dragged() {
+        spot += resp.drag_delta();
+    } else if resp.clicked()
+        && let Some(q) = resp.interact_pointer_pos()
+    {
+        spot = q;
+    }
+    let inner = img.shrink(4.0);
+    spot = pos2(spot.x.clamp(inner.left(), inner.right()), spot.y.clamp(inner.top(), inner.bottom()));
+    ui.data_mut(|d| d.insert_temp(key, spot));
+    let mut add: bool = ui.data(|d| d.get_temp::<bool>(add_key)).unwrap_or(false);
+
+    let painter = ui.painter_at(canvas);
+    for (radius, width) in [(RING, 3.0), (7.0, 1.5)] {
+        painter.circle_stroke(spot, radius, Stroke::new(width + 2.5, Color32::from_black_alpha(120)));
+        painter.circle_stroke(spot, radius, Stroke::new(width, Color32::from_gray(235)));
+    }
+    let hint = crate::i18n::tr("Drag the ring onto the colour, then tap the check mark");
+    for (offset, color) in [(vec2(1.0, 1.0), Color32::from_black_alpha(200)), (vec2(0.0, 0.0), Color32::WHITE)] {
+        painter.text(pos2(canvas.center().x, canvas.top() + 22.0) + offset, Align2::CENTER_CENTER, hint, egui::FontId::proportional(14.0), color);
+    }
+
+    let y = canvas.bottom() - 40.0;
+    let t = Tokens::get(ui.ctx());
+    let cancel = Rect::from_center_size(pos2(canvas.center().x - 70.0, y), vec2(52.0, 52.0));
+    let mode = Rect::from_center_size(pos2(canvas.center().x, y), vec2(52.0, 52.0));
+    let apply = Rect::from_center_size(pos2(canvas.center().x + 70.0, y), vec2(52.0, 52.0));
+    // the add / replace chip
+    let r = ui.interact(mode, egui::Id::new("color-range-mode"), Sense::click());
+    painter.circle_filled(mode.center(), 26.0, if add { t.accent } else { Color32::from_gray(60) });
+    painter.text(mode.center(), Align2::CENTER_CENTER, if add { "+" } else { "1" }, egui::FontId::proportional(22.0), Color32::WHITE);
+    if r.clicked() {
+        add = !add;
+        ui.data_mut(|d| d.insert_temp(add_key, add));
+    }
+    if r.hovered() || r.is_pointer_button_down_on() {
+        painter.text(
+            pos2(canvas.center().x, y - 42.0),
+            Align2::CENTER_CENTER,
+            if add { crate::i18n::tr("Adds the colour to the range") } else { crate::i18n::tr("Replaces the range") },
+            egui::FontId::proportional(13.0),
+            Color32::WHITE,
+        );
+    }
+    for (rect, id, fill, icon) in
+        [(cancel, "color-range-close", Color32::from_gray(60), crate::icons::Icon::Close), (apply, "color-range-apply", t.accent, crate::icons::Icon::Check)]
+    {
+        let r = ui.interact(rect, egui::Id::new(id), Sense::click());
+        painter.circle_filled(rect.center(), 26.0, if r.is_pointer_button_down_on() { fill.gamma_multiply(0.8) } else { fill });
+        crate::icons::paint(&painter, Rect::from_center_size(rect.center(), vec2(24.0, 24.0)), icon, Color32::WHITE);
+        if r.clicked() {
+            if id == "color-range-apply" {
+                let n = map.norm(spot);
+                match app.run("mask.sampleColor", json!({"x": n.x, "y": n.y, "add": add})) {
+                    // after the first sample the next ones are added
+                    Ok(_) => ui.data_mut(|d| {
+                        d.insert_temp(add_key, true);
+                    }),
+                    Err(e) => app.toast(ui.ctx(), e),
+                }
+            } else {
+                app.ui.tool.clear();
+                ui.data_mut(|d| {
+                    d.remove::<Pos2>(key);
+                    d.remove::<bool>(add_key);
+                });
+            }
+        }
+    }
+}
