+//! Lens profile commands (Android port): list the lenses of the loaded database, load profile files and choose
+//! the profile of the active photo.
+//!
+//! The database is in the lensfun XML format ([`crate::lens_profiles`]); the app ships none, the user loads one.
+
+use lightcraft_catalog::Op;
+use lightcraft_develop::EmbeddedLens;
+use serde_json::{Value, json};
+
+use super::{CommandSpec, always, bad, cmd, has_active, ok};
+use crate::lens_profiles as lens_db;
+use crate::{Result, Session};
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![
+        cmd!(
+            "optics.lensProfiles",
+            "List Lens Profiles",
+            [],
+            None,
+            "{filter?: words the maker or model must contain, limit?: number (default 60; 0 lists no lenses, only the suggested and current ones)} -> {loaded: bool, total: number of lenses, lenses: [{id, maker, model, crop_factor}], suggested: the profile that matches the active photo's lens or null, current: the active photo's chosen profile or null}",
+            always,
+            |s, p| {
+                let Some(db) = lens_db::database() else {
+                    return Ok(json!({"loaded": false, "total": 0, "lenses": [], "suggested": null, "current": null}));
+                };
+                let filter = p.get("filter").and_then(Value::as_str).unwrap_or_default();
+                let limit = p.get("limit").and_then(Value::as_u64).map_or(60, |l| l.min(500) as usize);
+                let photo = s.active().and_then(|id| s.catalog.photo(id));
+                let entry = |profile: &lightcraft_lensdb::Profile| {
+                    json!({"id": lens_db::profile_id(profile), "maker": profile.maker, "model": profile.models.first(), "crop_factor": profile.crop_factor})
+                };
+                // the profile that matches the photo's EXIF lens name
+                let suggested = photo.and_then(|ph| {
+                    let camera = lens_db::camera_named(&db, &ph.meta.camera);
+                    db.find_lens(None, &ph.meta.lens, camera).map(entry)
+                });
+                let current = photo.and_then(|ph| ph.embedded_lens).filter(|l| l.profile_id != 0).and_then(|l| lens_db::find_by_id(&db, l.profile_id).map(entry));
+                Ok(json!({
+                    "loaded": true,
+                    "total": db.lenses.len(),
+                    "lenses": if limit == 0 { Vec::new() } else { lens_db::entries(&db, filter, limit) },
+                    "suggested": suggested,
+                    "current": current,
+                }))
+            }
+        ),
+        cmd!(
+            "optics.loadLensProfiles",
+            "Load Lens Profiles",
+            [],
+            None,
+            "{path: a lensfun-format XML file or a folder of them} -> {lenses: number found} - the files are copied into the settings folder",
+            always,
+            |_s, p| {
+                let path = p.get("path").and_then(Value::as_str).ok_or_else(|| bad("optics.loadLensProfiles", "missing `path`"))?;
+                let lenses = lens_db::import(std::path::Path::new(path)).map_err(|e| bad("optics.loadLensProfiles", e))?;
+                Ok(json!({"lenses": lenses}))
+            }
+        ),
+        cmd!(
+            "optics.lensProfile",
+            "Set Lens Profile",
+            [],
+            None,
+            "{id: a lens id from optics.lensProfiles, or \"auto\" (the profile that matches the photo's lens) or \"none\", focal?: mm, used when the photo records none (else the lens's first calibrated focal length)} - applies the profile's distortion, vignetting and chromatic aberration correction to the active photo",
+            has_active,
+            |s, p| set_profile(s, p.get("id").cloned().unwrap_or_else(|| json!("auto")), p.get("focal").and_then(Value::as_f64))
+        ),
+    ]
+}
+
+/// Gives the active photo the lens correction `choice` names and switches the lens corrections on (or off for none).
+fn set_profile(s: &mut Session, choice: Value, p_focal: Option<f64>) -> Result<Value> {
+    const C: &str = "optics.lensProfile";
+    let id = s.active().ok_or_else(|| bad(C, "no active photo"))?;
+    let photo = s.catalog.photo(id).ok_or_else(|| bad(C, "no such photo"))?;
+    let (w, h) = (f64::from(photo.width), f64::from(photo.height));
+    let (focal, aperture) = (photo.meta.focal_mm.map(f64::from), photo.meta.aperture.map(f64::from));
+    let (camera, lens_name) = (photo.meta.camera.clone(), photo.meta.lens.clone());
+
+    let correction: Option<EmbeddedLens> = match &choice {
+        Value::String(c) if c == "none" => None,
+        _ => {
+            let db = lens_db::database().ok_or_else(|| bad(C, "no lens profiles are loaded"))?;
+            let profile = match &choice {
+                Value::String(c) if c == "auto" => {
+                    db.find_lens(None, &lens_name, lens_db::camera_named(&db, &camera)).ok_or_else(|| bad(C, "no profile matches this photo's lens"))?
+                }
+                Value::Number(n) => n.as_u64().and_then(|n| lens_db::find_by_id(&db, n)).ok_or_else(|| bad(C, "no such lens profile"))?,
+                _ => return Err(bad(C, "id is a lens id, \"auto\" or \"none\"")),
+            };
+            // the focal length the photo records; else the one asked for; else the lens's first calibrated focal length
+            let asked = p_focal.filter(|f| f.is_finite() && *f > 0.0);
+            let focal = focal
+                .filter(|f| f.is_finite() && *f > 0.0)
+                .or(asked)
+                .or_else(|| profile.distortion.first().map(|d| d.0).or_else(|| profile.vignetting.first().map(|v| v.focal)))
+                .ok_or_else(|| bad(C, "the photo records no focal length and the profile has none to fall back on"))?;
+            let corr = lens_db::correction_for(&db, profile, &camera, focal, aperture, w, h)
+                .ok_or_else(|| bad(C, "the profile has no correction for this focal length"))?;
+            Some(corr)
+        }
+    };
+    let on = correction.is_some();
+    s.commit("Lens Profile", Op::SetEmbeddedLens { id, lens: correction.map(Box::new) })?;
+    // switch the corrections on (the amounts stay as they are), or off with "none"
+    let mut d = (*s.develop_of(id).unwrap_or_default()).clone();
+    if d.optics.lens_profile != on {
+        d.optics.lens_profile = on;
+        s.set_develop(id, d, "Lens Profile")?;
+    }
+    s.media.forget(id);
+    ok()
+}
