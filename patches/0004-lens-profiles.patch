+
+/// Loads lens profiles from `path`: one lensfun-format XML file, or a folder of them. The files are copied to
+/// [`store_dir`], so they stay available when the original goes away, and the database is read again. Returns
+/// the number of lenses found in the files.
+pub fn import(path: &Path) -> Result<usize, String> {
+    let files: Vec<PathBuf> = if path.is_dir() {
+        let mut found: Vec<PathBuf> = std::fs::read_dir(path)
+            .map_err(|e| format!("{}: {e}", path.display()))?
+            .flatten()
+            .map(|e| e.path())
+            .filter(|p| p.extension().is_some_and(|e| e.eq_ignore_ascii_case("xml")))
+            .collect();
+        found.sort();
+        found
+    } else {
+        vec![path.to_path_buf()]
+    };
+    if files.is_empty() {
+        return Err("no XML files found".into());
+    }
+    let store = store_dir().ok_or("there is no settings folder to keep the profiles in")?;
+    std::fs::create_dir_all(&store).map_err(|e| format!("{}: {e}", store.display()))?;
+    let mut lenses = 0;
+    for file in files {
+        let text = std::fs::read_to_string(&file).map_err(|e| format!("{}: {e}", file.display()))?;
+        // a file that is not a lens database is refused before anything is copied
+        let db = LensDb::parse(&text).map_err(|e| format!("{}: {e}", file.display()))?;
+        lenses += db.lenses.len();
+        let name = file.file_name().map(|n| n.to_os_string()).ok_or("the file has no name")?;
+        std::fs::write(store.join(name), text).map_err(|e| format!("{}: {e}", store.display()))?;
+    }
+    reload();
+    Ok(lenses)
+}
+
+/// A stable id of a database lens (the same on every start): a hash of its maker and first model name.
+pub fn profile_id(p: &Profile) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    for byte in p.maker.bytes().chain(std::iter::once(0)).chain(p.models.first().map(|m| m.bytes()).into_iter().flatten()) {
+        h ^= u64::from(byte);
+        h = h.wrapping_mul(0x0100_0000_01b3);
+    }
+    // 0 means "no profile"
+    h.max(1)
+}
+
+/// The database lens with this id.
+pub fn find_by_id(db: &LensDb, id: u64) -> Option<&Profile> {
+    db.lenses.iter().find(|p| profile_id(p) == id)
+}
+
+/// A lens of the database, as the UI lists it.
+#[derive(Clone, Debug, PartialEq, serde::Serialize)]
+pub struct Entry {
+    pub id: u64,
+    pub maker: String,
+    pub model: String,
+    pub crop_factor: f64,
+}
+
+/// The lenses whose maker or model contains every word of `filter` (case-insensitive), at most `limit`,
+/// sorted by maker and model.
+pub fn entries(db: &LensDb, filter: &str, limit: usize) -> Vec<Entry> {
+    let words: Vec<String> = filter.split_whitespace().map(str::to_lowercase).collect();
+    let mut out: Vec<Entry> = db
+        .lenses
+        .iter()
+        .filter(|p| {
+            let text = format!("{} {}", p.maker, p.models.join(" ")).to_lowercase();
+            words.iter().all(|w| text.contains(w))
+        })
+        .map(|p| Entry { id: profile_id(p), maker: p.maker.clone(), model: p.models.first().cloned().unwrap_or_default(), crop_factor: p.crop_factor })
+        .collect();
+    out.sort_by(|a, b| (a.maker.to_lowercase(), a.model.to_lowercase()).cmp(&(b.maker.to_lowercase(), b.model.to_lowercase())));
+    out.truncate(limit);
+    out
+}
+
+/// The database camera named by `camera` (the make and model as one string, as the catalogue keeps it).
+pub fn camera_named<'a>(db: &'a LensDb, camera: &str) -> Option<&'a lightcraft_lensdb::Camera> {
+    let camera = camera.to_lowercase();
+    if camera.is_empty() {
+        return None;
+    }
+    db.cameras.iter().find(|c| camera.contains(&format!("{} {}", c.maker, c.model).to_lowercase()))
+}
+
+/// The correction of `profile` for a photo `w × h` pixels with the given focal length and aperture. The camera's crop
+/// factor is looked up by `camera` (the make and model as one string) and is the profile's own when unknown.
+pub fn correction_for(db: &LensDb, profile: &Profile, camera: &str, focal: f64, aperture: Option<f64>, w: f64, h: f64) -> Option<EmbeddedLens> {
+    let cam = camera_named(db, camera);
+    let shot = Shot { focal, aperture, distance: None, crop_factor: cam.map(|c| c.crop_factor), width: w, height: h };
+    let mut corr = profile.correction(&shot)?;
+    corr.profile_id = profile_id(profile);
+    Some(corr)
 }
 
